body {
    background: #f4f4f4;
    font-family: Arial, sans-serif;
}

.container {
    width: 750px;
    margin: 40px auto;
    background: white;
    padding: 25px;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
}

.input-box {
    width: 100%;
    padding: 12px;
    margin-bottom: 12px;
    border: 1px solid #ccc;
    border-radius: 6px;
}

.run-btn {
    padding: 10px 16px;
    background: #6a0dad;
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
}

.run-btn:hover {
    background: #570a9a;
}

.result-block {
    margin-top: 20px;
    background: #fafafa;
    padding: 15px;
    border-radius: 8px;
}

pre {
    background: white;
    padding: 10px;
    border-radius: 6px;
    overflow-x: auto;
}

.stderr {
    color: red;
}

.clear-btn {
    padding: 10px 16px;
    /* Use a neutral/secondary color */
    background: #ccc; 
    color: #333;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-weight: bold;
    margin-left: 8px; /* Add spacing from the Run button */
    transition: background 0.2s;
}

.clear-btn:hover {
    background: #bbb;
}